# SignalFlow — copy to `.env` and fill in what you have.
# Both keys are OPTIONAL: without them the app runs with the offline
# rule-based explainer and no voice output. The dashboard shows the status.

# --- Featherless.ai (open models, OpenAI-compatible) --------------
# Get a key: https://featherless.ai  -> sign in -> API Keys
# Base URL is already correct; change only if the docs say otherwise.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE=https://api.featherless.ai/v1
# Any model id from the Featherless catalogue, e.g. Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- ElevenLabs (text-to-speech) ----------------------------------
# Get a key: https://elevenlabs.io -> Workspace settings -> API Keys
ELEVENLABS_API_KEY=
# Default voice "Rachel"; list voices at /v1/voices with your key.
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Server -------------------------------------------------------
SIGNALFLOW_HOST=127.0.0.1
SIGNALFLOW_PORT=8000
